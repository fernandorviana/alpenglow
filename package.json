{
  "name": "alpenglow",
  "version": "0.0.0",
  "description": "A design system for dense, data-heavy interfaces. Light and dark, measured for contrast.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:css": "tsx scripts/build-css.ts && tsx scripts/build-tailwind.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "check": "npm run typecheck && npm run lint && npm test",
    "dev": "next dev",
    "build:docs": "npm run build:css && next build",
    "build:tailwind": "tsx scripts/build-tailwind.ts",
    "start": "next start"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@carbon/icons-react": "^11.87.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vercel/analytics": "^2.0.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
